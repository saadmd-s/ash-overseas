{
  "name": "ash-overseas-ledger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "description": "Private single-user trading ledger — one signed balance per dealer, integer paise throughout.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply ledger-dev --local",
    "db:migrate:dev": "wrangler d1 migrations apply ledger-dev --remote",
    "db:migrate:prod": "wrangler d1 migrations apply ledger-prod --env production --remote",
    "db:export": "node scripts/db-export.ts --env production --database ledger-prod",
    "db:export:dev": "node scripts/db-export.ts --database ledger-dev",
    "db:verify-restore": "node scripts/verify-restore.ts",
    "auth:setup": "node scripts/set-credentials.ts",
    "deploy:prod": "node scripts/deploy-prod.ts",
    "db:export:local": "node scripts/db-export.ts --local --database ledger-dev"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "drizzle-orm": "^0.44.2",
    "hono": "^4.8.4",
    "lucide-react": "^1.38.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.9.0",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260829.1",
    "@eslint/js": "^9.30.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.36.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.24.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "@tailwindcss/oxide"
    ]
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
