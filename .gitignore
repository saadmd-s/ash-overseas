# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/versions

# Build output
dist/
build/
.next/
out/
.output/
.vite/
*.tsbuildinfo

# Cloudflare / Wrangler
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example
wrangler.toml.bak

# Local D1 / SQLite databases — never commit business data
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# Drizzle
# Generated migration SQL IS committed (drizzle/migrations/).
# Only the introspection scratch output is ignored.
drizzle/meta/_journal.json.bak
.drizzle/

# Environment & secrets
.env
.env.*
!.env.example
*.pem
*.key

# Testing
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
.vitest/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# Database dumps — a complete copy of the ledger in plain text (SRS §17.3).
# `pnpm db:export` writes here and NOTHING in it may ever be committed.
backups/

# Exported spreadsheets — generated artefacts, may contain business figures
*.xlsx
*.xls
*.csv
!docs/**/*.csv

# Misc
.cache/
.temp/
.tmp/
